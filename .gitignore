# Dependencies
node_modules/

# Build outputs
dist/

# Test and tool caches
.vitest/
node_modules/.vite/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS/editor noise
.DS_Store

# Local agent/tool state
.codex
.vercel/
.ralph-wiggum/
.worktrees/
.idx/
.openclaude-profile.json
.vercel
.env*.local
.afes-local/
.claude/settings.local.json
.claude/worktrees/

# Raw data — not committed
public/data/companies/**/*.xls
public/data/companies/**/*.xlsx
public/data/companies/**/*.html
public/data/companies/**/standalone/
# Annual Reports (PDFs, ~2.9GB) — used by extract_*_quality.py scripts
public/data/annual_reports/
# Python bytecode caches
__pycache__/
*.pyc
# Allow pre-built library ZIPs so Vercel serves them for the "Load from library" dropdown
!public/data/companies/**/*.zip

# Local scratch (debugging artifacts)
scratch/
scratch_*

# Security / reverse-engineering research scripts (unrelated to the app)
frida_*.js
frida_*.log
security_assessment.py
extract_proto*.py
parse_frida_dump.py

# Debug JSONL captures
*_out.jsonl
capture_out.jsonl
proto_dump.jsonl

# Hermes agent temporary files and unmerged plans
.hermes/tmp/
.hermes/plans/

# Test results / playwright artifacts
test-results/
playwright-report/
