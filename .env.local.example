# .env.local.example - copy to .env.local and fill in
#
# .env.local is gitignored. This template documents every env var the
# project reads so a fresh-clone setup is one `cp` away from working.
#
#   cp .env.local.example .env.local
#   # then edit .env.local with real values
#
# In production, set these in Vercel: Project Settings > Environment Variables.
# Vercel fail-closes when secrets are missing — protected endpoints return
# 401/503 instead of allowing writes.

# ============================================================
# CORE - Required for local dev
# ============================================================

# Local Express API server port. Default 3001. Vite proxies /api/* to it.
LOCAL_SERVER_PORT=3001

# ============================================================
# VERCEL BLOB STORAGE - Required to publish company data to production
# ============================================================
# Get from: Vercel Dashboard > Storage > <your blob store> > Connect
# This is a WRITE-ENABLED token. Treat as secret. Never commit.
# Used by: scripts/upload-to-blob.mjs, api/research/*, api/blackboard/*
# Active store: penman-v2-analysis-vercel-blob
#   (zvbqldg4jamf3lhr.public.blob.vercel-storage.com)
BLOB_READ_WRITE_TOKEN=

# ============================================================
# MARKET DATA PROVIDERS - Optional
# ============================================================
# Default is the NSE proxy (no API key needed). Switch providers per-request
# via /api/market-data/snapshot?provider=yahoo|nse|alphavantage|upstox.
MARKET_DATA_PROVIDER=nse

# Alpha Vantage (https://www.alphavantage.co/support/#api-key) - free tier OK
ALPHAVANTAGE_API_KEY=

# Upstox (https://upstox.com/developer/) - paid, Indian markets focus
UPSTOX_ACCESS_TOKEN=

# ============================================================
# AUDIT PIPELINE - Required only if you use the audit features
# ============================================================
# Admin token gates POST/PUT to /api/audit/*. Production fail-closes when
# missing. For local dev you can set any string; for prod use a real secret.
AUDIT_ADMIN_TOKEN=
AUDIT_ADMIN_TOKEN_VERSION=v1

# Token rotation (set both during a rollover window)
AUDIT_ADMIN_TOKEN_PREVIOUS=
AUDIT_ADMIN_TOKEN_PREVIOUS_VERSION=

# Audit rate limits / size caps (sane defaults are baked in; override if needed)
AUDIT_MAX_EVENTS_PER_MINUTE=120
AUDIT_MAX_EVENT_BYTES=65536
AUDIT_MAX_UPLOADS_PER_MINUTE=10
AUDIT_MAX_UPLOAD_BYTES=10485760
AUDIT_RETENTION_DAYS=90

# Audit monitor (cron job at 02:17 UTC daily)
AUDIT_MONITOR_ENABLED=true
AUDIT_MONITOR_STALL_MINUTES=180
AUDIT_MONITOR_LOOKBACK_LIMIT=500
AUDIT_MONITOR_ARTIFACT_GRACE_MINUTES=60

# Run inspector (debugging surface)
AUDIT_RUN_INSPECTOR_ENABLED=false
AUDIT_SENSITIVE_DOCUMENT_CLASS=internal

# ============================================================
# RESEARCH API - Optional
# ============================================================
# Set RESEARCH_REQUIRE_READ_AUTH=true and RESEARCH_REQUIRE_WRITE_AUTH=true
# to require a valid auth token on every research endpoint call.
# Production defaults to write-protected. Read-protection is opt-in.
RESEARCH_REQUIRE_READ_AUTH=false
RESEARCH_REQUIRE_WRITE_AUTH=true

# ============================================================
# CRON ENDPOINTS - Required only if you use Vercel cron
# ============================================================
# Without CRON_SECRET, /api/cron/* returns 503. Set this in Vercel only;
# locally it's not needed unless you're testing cron handlers directly.
CRON_SECRET=

# ============================================================
# GITHUB MONITOR - Optional
# ============================================================
# Repo to ingest issue/PR signal from. Token needs read:repo scope.
GITHUB_MONITOR_REPO=rajesh180675/penman-v2-analysis-vercel
GITHUB_MONITOR_TOKEN=

# ============================================================
# AUTO-INJECTED BY VERCEL - Do not set
# ============================================================
# VERCEL=1 (set automatically in Vercel deployments)
