AME --><div ng-repeat="(name,val) in prop" ng-if="name == cols.COLUMNNAME" class="ng-scope">
                                        <!-- ngIf: isNum(val) && name !='YearEnd' && name !='NoOfShares' && name != 'SubsidiarysYearend' -->
