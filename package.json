{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "concurrently --kill-others-on-fail \"vite\" \"tsx server/index.ts\"",
    "server": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:golden": "vitest run src/engine/__tests__/goldenCompanySuite.spec.ts src/engine/__tests__/releaseGate.spec.ts",
    "test": "vitest run",
    "validate": "npm run typecheck && npm run test && npm run build",
    "validate:release": "npm run typecheck && npm run test:golden && npm run test && npm run build"
  },
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "@vercel/blob": "^2.3.2",
    "clsx": "2.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dompurify": "^3.3.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jsdom": "^29.1.1",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.33",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "tsx": "^4.22.2",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^4.0.18",
    "xlsx": "^0.18.5"
  }
}
